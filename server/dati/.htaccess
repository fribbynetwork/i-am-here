# I file dei percorsi non devono essere scaricabili scrivendone
# l'indirizzo nel browser. Senza questa regola, chi indovina un id
# aggira ogni controllo andando dritto al JSON.
#
# The journey files must not be downloadable by typing their address
# into a browser. Without this rule, anyone guessing an id bypasses
# every check by going straight to the JSON.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
