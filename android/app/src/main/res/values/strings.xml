    <!-- diagnostics -->
    <string name="diagnostics_intro">Red rows stop sharing from working. Amber ones only make it sturdier. This page rechecks itself while anything is missing.</string>
    <string name="diagnostics_all_ok">Everything is in place. Sharing can run undisturbed.</string>
    <string name="diagnostics_only_optional">The essentials are in place. What is left in amber is an improvement, not a requirement.</string>
    <string name="check_fine_location">Precise location</string>
    <string name="check_fine_location_help">Without this permission no coordinate is available at all.</string>
    <string name="check_background_location">Location all the time</string>
    <string name="check_background_location_help">Since Android 11 this is granted by hand in the system settings, choosing \"Allow all the time\".</string>
    <string name="check_gps_on">GPS switched on</string>
    <string name="check_gps_on_help">The system location service must be active.</string>
    <string name="check_notifications">Notifications</string>
    <string name="check_notifications_help">The foreground service needs its persistent notification.</string>
    <string name="check_sms">SMS sending</string>
    <string name="check_sms_help">Only needed if you use the SMS channel.</string>
    <string name="restricted_settings">SMS permission greyed out?</string>
    <string name="restricted_settings_help">Android blocks the SMS permission for apps installed straight from an APK file, and shows a shield saying access was denied. To unblock it: Settings, Apps, this app, then the three-dot menu at the top right and the entry about restricted settings. Confirm with your PIN or fingerprint, and the permission can then be granted normally. Apps installed from a store, F-Droid included, never hit this.</string>
    <string name="check_battery">Battery not optimised</string>
    <string name="check_battery_help">Not required: a foreground service keeps working anyway. The exemption helps on long stops with the screen off and after a reboot.</string>
    <string name="open_settings">Open</string>
    <string name="autostart">Autostart</string>
    <string name="autostart_help">On Xiaomi, Huawei, Oppo, Vivo and Samsung the system kills background services even with every permission granted. Look for \"Autostart\" in the phone settings and enable it for this app.</string>

