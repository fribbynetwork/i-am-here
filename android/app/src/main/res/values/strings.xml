    <string name="connection">Connection</string>
    <string name="connection_help">Both of these lower the protection of what you send. Leave them off unless you know why you are turning them on.</string>
    <string name="allow_cleartext">Allow plain HTTP</string>
    <string name="allow_cleartext_help">Lets you use an http:// endpoint. Needed for a server with no certificate.</string>
    <string name="allow_insecure_tls">Accept invalid certificates</string>
    <string name="allow_insecure_tls_help">For a personal server with a self-signed certificate.</string>
    <string name="security_warning">Reduced protection</string>
    <string name="security_warning_http">Over plain HTTP everything travels readable: coordinates and the key in the URL. Anyone on the same network can see them. Use it only towards a server on your own network.</string>
    <string name="security_warning_tls">With certificate checking off, the app can no longer tell your server from anyone pretending to be it. Whoever controls the network can read and alter what you send, key included. Use it only towards a server you run yourself.</string>
    <string name="cleartext_blocked">http:// blocked. Turn on plain HTTP in the settings.</string>
